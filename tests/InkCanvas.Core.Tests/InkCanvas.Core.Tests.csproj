<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows TFM so the suite can also cover the Win32-facing Platform layer. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <!-- Ink 工程引用 Win2D/WindowsAppSDK；测试宿主必须自包含运行时。 -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\InkCanvas.Core\InkCanvas.Core.csproj" />
    <ProjectReference Include="..\..\src\InkCanvas.Platform\InkCanvas.Platform.csproj" />
    <ProjectReference Include="..\..\src\InkCanvas.Ink\InkCanvas.Ink.csproj" />
    <ProjectReference Include="..\..\src\InkCanvas.Features\InkCanvas.Features.csproj" />
    <ProjectReference Include="..\..\src\InkCanvas.Modules.ScreenTracking\InkCanvas.Modules.ScreenTracking.csproj" />
    <ProjectReference Include="..\..\src\InkCanvas.Extensions\InkCanvas.Extensions.csproj" />
    <ProjectReference Include="..\..\src\InkCanvas.Pdf\InkCanvas.Pdf.csproj" />
    <ProjectReference Include="..\..\src\InkCanvas.AnalyticGeometry\InkCanvas.AnalyticGeometry.csproj" />
    <ProjectReference Include="..\InkCanvas.PluginFixture\InkCanvas.PluginFixture.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\InkCanvas.PluginHost\InkCanvas.PluginHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
