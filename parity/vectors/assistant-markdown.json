      }
    },
    {
      "id": "counts-unclosed-inline-formula",
      "fn": "markdownProbe",
      "input": ["答案是 $x="],
      "expected": {
        "BlockCount": 1,
        "OpenFence": false,
        "IncompleteFormula": 1,
