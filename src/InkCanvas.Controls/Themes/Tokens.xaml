<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Theme tokens. Everything downstream references these via {ThemeResource}, so light/dark
      switching is a single dictionary swap and no control hard-codes a colour.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="IcSurfaceColor">#FFF6F7F9</Color>
            <Color x:Key="IcSurfaceAltColor">#FFFFFFFF</Color>
            <Color x:Key="IcStrokeColor">#1F000000</Color>
            <Color x:Key="IcTextPrimaryColor">#E4000000</Color>
            <Color x:Key="IcTextSecondaryColor">#9E000000</Color>
            <Color x:Key="IcAccentColor">#FF0067C0</Color>
            <Color x:Key="IcAccentSoftColor">#1A0067C0</Color>
            <Color x:Key="IcBoardBlackColor">#FF1F3B2C</Color>
            <Color x:Key="IcBoardWhiteColor">#FFFAFAFA</Color>
            <SolidColorBrush x:Key="IcSurfaceBrush" Color="#FFF6F7F9" />
            <SolidColorBrush x:Key="IcSurfaceAltBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="IcStrokeBrush" Color="#1F000000" />
            <SolidColorBrush x:Key="IcTextPrimaryBrush" Color="#E4000000" />
            <SolidColorBrush x:Key="IcTextSecondaryBrush" Color="#9E000000" />
            <SolidColorBrush x:Key="IcAccentBrush" Color="#FF0067C0" />
            <SolidColorBrush x:Key="IcAccentSoftBrush" Color="#1A0067C0" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="IcSurfaceColor">#FF202124</Color>
            <Color x:Key="IcSurfaceAltColor">#FF2B2C2F</Color>
            <Color x:Key="IcStrokeColor">#24FFFFFF</Color>
            <Color x:Key="IcTextPrimaryColor">#F2FFFFFF</Color>
            <Color x:Key="IcTextSecondaryColor">#A8FFFFFF</Color>
            <Color x:Key="IcAccentColor">#FF4CC2FF</Color>
            <Color x:Key="IcAccentSoftColor">#264CC2FF</Color>
            <Color x:Key="IcBoardBlackColor">#FF16281E</Color>
            <Color x:Key="IcBoardWhiteColor">#FF1B1B1B</Color>
            <SolidColorBrush x:Key="IcSurfaceBrush" Color="#FF202124" />
            <SolidColorBrush x:Key="IcSurfaceAltBrush" Color="#FF2B2C2F" />
            <SolidColorBrush x:Key="IcStrokeBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="IcTextPrimaryBrush" Color="#F2FFFFFF" />
            <SolidColorBrush x:Key="IcTextSecondaryBrush" Color="#A8FFFFFF" />
            <SolidColorBrush x:Key="IcAccentBrush" Color="#FF4CC2FF" />
            <SolidColorBrush x:Key="IcAccentSoftBrush" Color="#264CC2FF" />
        </ResourceDictionary>

        <!--
          High contrast mirrors the Light/Dark token names so {ThemeResource} lookups and
          ThemeBrushes.Resolve keep working when the system high-contrast flag is on.
          Values are literal (no StaticResource): black surfaces, white ink/text,
          cyan accent so accents stay visible on the black background.
        -->
        <ResourceDictionary x:Key="HighContrast">
            <Color x:Key="IcBoardBlackColor">#FF000000</Color>
            <Color x:Key="IcBoardWhiteColor">#FFFFFFFF</Color>
            <SolidColorBrush x:Key="IcSurfaceBrush" Color="#FF000000" />
            <SolidColorBrush x:Key="IcSurfaceAltBrush" Color="#FF000000" />
            <SolidColorBrush x:Key="IcStrokeBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="IcTextPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="IcTextSecondaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="IcAccentBrush" Color="#FF00FFFF" />
            <SolidColorBrush x:Key="IcAccentSoftBrush" Color="#FF000000" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Touch sizing: every interactive target is at least 40px, per the touch contract. -->
    <x:Double x:Key="IcTouchTargetMin">40</x:Double>
    <x:Double x:Key="IcTouchTargetComfortable">48</x:Double>
    <x:Double x:Key="IcFloatingBarIcon">22</x:Double>
    <CornerRadius x:Key="IcControlCorner">8</CornerRadius>
    <CornerRadius x:Key="IcBarCorner">14</CornerRadius>
    <Thickness x:Key="IcBarPadding">8,6,8,6</Thickness>
    <Thickness x:Key="IcCardPadding">16,12,16,12</Thickness>
</ResourceDictionary>