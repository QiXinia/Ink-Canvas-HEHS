<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>InkCanvas.Controls</RootNamespace>
    <AssemblyName>InkCanvas.Controls</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="$(Win2DVersion)" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\InkCanvas.Extensibility\InkCanvas.Extensibility.csproj" />
    <ProjectReference Include="..\InkCanvas.Core\InkCanvas.Core.csproj" />
    <ProjectReference Include="..\InkCanvas.Platform\InkCanvas.Platform.csproj" />
    <ProjectReference Include="..\InkCanvas.Ink\InkCanvas.Ink.csproj" />
  </ItemGroup>
</Project>
